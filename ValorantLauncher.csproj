<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>Pulse</RootNamespace>
    <Product>PULSE</Product>
    <ApplicationTitle>PULSE</ApplicationTitle>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LicenseServer\**\*.cs" />
    <Compile Remove="LicenseIssuer\**\*.cs" />
    <Compile Remove="LicenseIssuerDesktop\**\*.cs" />
    <Page Remove="LicenseIssuerDesktop\**\*.xaml" />
    <ApplicationDefinition Remove="LicenseIssuerDesktop\**\*.xaml" />
    <EmbeddedResource Remove="LicenseServer\**\*" />
    <EmbeddedResource Remove="LicenseIssuerDesktop\**\*" />
    <EmbeddedResource Include="LicensingCore\pulse-license-public-key.pem"
                      LogicalName="Pulse.LicensingCore.PublicKey.pem" />
  </ItemGroup>
</Project>

<Window x:Class="Pulse.LicenseIssuer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PULSE License Issuer"
        Width="620"
        Height="740"
        MinWidth="560"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0C0E12"
                BorderBrush="#20232A"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PULSE"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <Border Width="1" Height="16" Margin="14,0" Background="#343740"/>
                    <TextBlock Text="LICENSE ISSUER"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Button Width="34"
                        Height="30"
                        HorizontalAlignment="Right"
                        Content="×"
                        FontSize="19"
                        Foreground="{StaticResource MutedBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_OnClick"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,28,32,30">
                <StackPanel>
                    <TextBlock Text="OFFLINE LICENSING"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Issue a license."
                               Margin="0,9,0,0"
                               FontSize="30"
                               FontWeight="Light"/>
                    <TextBlock Text="Create a device-bound key for a PULSE installation."
                               Margin="0,7,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                    <Border Margin="0,25,0,0"
                            Padding="17,14"
                            Background="#101217"
                            BorderBrush="#252830"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="KeyStatusDot"
                                     Width="6"
                                     Height="6"
                                     Fill="#9EA3AD"
                                     VerticalAlignment="Top"
                                     Margin="0,6,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="KeyStatusTitle"
                                           Text="CHECKING SIGNING KEY"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="KeyStatusDescription"
                                           Text="Verifying the local issuer key and app public key."
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="DEVICE ID"
                               Margin="0,26,0,8"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="DeviceIdInput"
                             MaxLength="32"
                             CharacterCasing="Upper"
                             ToolTip="32 hexadecimal characters shown in the PULSE license screen"
                             TextChanged="DeviceIdInput_OnTextChanged"/>
                    <TextBlock Text="Enter the 32-character ID shown in the customer's PULSE app."
                               Margin="1,7,0,0"
                               Foreground="#737985"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="LICENSE TYPE"
                               Margin="0,22,0,8"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="LicenseTypeInput" SelectedIndex="0">
                        <ComboBoxItem Content="7-DAY LICENSE"/>
                        <ComboBoxItem Content="30-DAY LICENSE"/>
                        <ComboBoxItem Content="PERMANENT LICENSE"/>
                    </ComboBox>

                    <Button x:Name="IssueButton"
                            Content="GENERATE LICENSE KEY"
                            Style="{StaticResource ActionButton}"
                            Margin="0,22,0,0"
                            Click="IssueButton_OnClick"/>

                    <TextBlock Text="GENERATED KEY"
                               Margin="0,25,0,8"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="GeneratedKeyOutput"
                             MinHeight="82"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Center"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="14"/>
                    <Button x:Name="CopyButton"
                            Content="COPY KEY"
                            Style="{StaticResource QuietButton}"
                            Margin="0,10,0,0"
                            IsEnabled="False"
                            Click="CopyButton_OnClick"/>
                    <TextBlock x:Name="FeedbackText"
                               Margin="1,12,1,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

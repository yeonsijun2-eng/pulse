<Window x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Pulse.Controls"
        Title="PULSE"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource PulseFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Margin="7"
            Background="{StaticResource BgBrush}"
            BorderBrush="#25262C"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#08090C" Offset="0"/>
                    <GradientStop Color="#101116" Offset="0.55"/>
                    <GradientStop Color="#090A0D" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0A0B0E"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="22,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="26" Height="26" Margin="0,0,11,0">
                            <Ellipse Stroke="#5FFFFFFF" StrokeThickness="1"/>
                            <Path Data="M5,13 L9,13 L11,8 L14,18 L17,11 L21,11"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Fill"
                                  Margin="5"/>
                        </Grid>
                        <TextBlock Text="PULSE" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Width="1" Height="15" Background="#33353D" Margin="14,0"/>
                        <TextBlock Text="VALORANT COMPANION"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#101115"
                                BorderBrush="#292B32"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="10,5"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#B9BDC6" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="OFFLINE LICENSE"
                                           Foreground="#C0C3CA"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource CaptionButton}" Content="—" Click="Minimize_Click"/>
                        <Button Style="{StaticResource CaptionButton}" Content="□" Click="Maximize_Click"/>
                        <Button Style="{StaticResource CaptionButton}" Content="×" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="0,0,1,0"
                        Background="#08090C"
                        Padding="15,18,15,17"
                        Visibility="{Binding IsShell, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <Border Padding="14,16"
                                    Margin="2,2,2,28"
                                    BorderBrush="#24262D"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Background="#0D0E12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PULSE" FontSize="24" FontWeight="Light"/>
                                        <TextBlock Text="PLAY WITH PRECISION"
                                                   Margin="1,5,0,0"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="01"
                                               Foreground="#666B76"
                                               FontSize="9"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="WORKSPACE"
                                       Margin="11,0,0,11"
                                       Foreground="#676B75"
                                       FontSize="8"
                                       FontWeight="SemiBold"/>
                            <RadioButton Content="{DynamicResource NavHome}"
                                         Style="{StaticResource NavButton}"
                                         IsChecked="{Binding IsHome, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Home"
                                         GroupName="PulseNav"/>
                            <RadioButton Content="{DynamicResource NavInjector}"
                                         Style="{StaticResource NavButton}"
                                         Margin="0,5,0,0"
                                         IsChecked="{Binding IsInjector, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Injector"
                                         GroupName="PulseNav"/>
                            <RadioButton Content="{DynamicResource NavSettings}"
                                         Style="{StaticResource NavButton}"
                                         Margin="0,5,0,0"
                                         IsChecked="{Binding IsSettings, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Settings"
                                         GroupName="PulseNav"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom"
                                Margin="2,16,2,0"
                                Padding="12,12"
                                BorderBrush="#202228"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#0B0C0F">
                            <StackPanel>
                                <TextBlock Text="PULSE DESKTOP"
                                           Foreground="#C4C6CC"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="VERSION 1.0.0  ·  WINDOWS"
                                           Foreground="#6D717B"
                                           FontSize="8"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <controls:TransitionHost Margin="34,30,34,34"
                                             Content="{Binding Content}"
                                             AnimationsEnabled="{Binding AnimationsEnabled}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="Pulse.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Settings}" FontSize="28" FontWeight="Light" Margin="0,0,0,22"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource HoloCard}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource InstallPath}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Shell.InstallPathText}"
                                   ToolTip="{Binding Shell.InstallPathText}"
                                   Margin="0,10,0,14"
                                   TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="{DynamicResource Browse}" Style="{StaticResource GhostButton}" Command="{Binding Shell.BrowseCommand}"/>
                            <Button Content="{DynamicResource RetryScan}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding Shell.ScanCommand}"/>
                            <Button Content="{DynamicResource Download}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding Shell.DownloadCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HoloCard}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Language}" FontSize="16" FontWeight="Light"/>
                            <TextBlock Text="{DynamicResource LanguageDescription}"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,16,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <RadioButton Content="{DynamicResource English}"
                                         Style="{StaticResource NavButton}"
                                         IsChecked="{Binding Shell.Language, Converter={StaticResource NavEquals}, ConverterParameter=en, Mode=OneWay}"
                                         GroupName="PulseLanguages"
                                         Command="{Binding Shell.SetLanguageCommand}"
                                         CommandParameter="en"/>
                            <RadioButton Content="{DynamicResource Korean}"
                                         Style="{StaticResource NavButton}"
                                         Margin="8,0,0,0"
                                         IsChecked="{Binding Shell.Language, Converter={StaticResource NavEquals}, ConverterParameter=ko, Mode=OneWay}"
                                         GroupName="PulseLanguages"
                                         Command="{Binding Shell.SetLanguageCommand}"
                                         CommandParameter="ko"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HoloCard}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Animations}" FontSize="16" FontWeight="Light"/>
                            <TextBlock Text="{DynamicResource AnimationsDescription}"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,16,0"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      Style="{StaticResource PulseToggle}"
                                      IsChecked="{Binding Shell.AnimationsEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource HoloCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Storage}" FontSize="16" FontWeight="Light"/>
                        <TextBlock Text="{Binding Shell.Error}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource SaveSettings}" Style="{StaticResource SolidButton}" Command="{Binding Shell.SaveSettingsCommand}"/>
                            <Button Content="{DynamicResource ResetSettings}" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding Shell.ResetSettingsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HoloCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LicenseAuthentication}" FontSize="16" FontWeight="Light"/>
                        <TextBlock Text="{Binding Shell.LicenseTypeText}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,14"/>
                        <Button Content="{DynamicResource Logout}"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Command="{Binding Shell.LogoutCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

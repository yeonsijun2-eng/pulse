<UserControl x:Class="Pulse.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,22">
            <TextBlock Text="PULSE" FontSize="28" FontWeight="Light"/>
            <TextBlock Text="{DynamicResource Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="16,0,0,4" FontSize="11"/>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource HoloCard}"
                Padding="16,12"
                Margin="0,0,0,16"
                Visibility="{Binding Shell.ShowInstallNotice, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource NotFoundHeadline}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource InstallNotice}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Download}" Style="{StaticResource SolidButton}" Margin="0,0,8,0" Command="{Binding Shell.DownloadCommand}"/>
                <Button Grid.Column="2" Content="{DynamicResource RetryScan}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding Shell.ScanCommand}"/>
                <Button Grid.Column="3" Content="{DynamicResource Dismiss}" Style="{StaticResource GhostButton}" Padding="12,8" Command="{Binding Shell.DismissInstallNoticeCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource HoloCard}"
                Padding="18,14"
                Margin="0,0,0,16"
                Visibility="{Binding Shell.ShowLicenseCard, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource LicenseTypeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    <TextBlock Text="{Binding Shell.LicenseTypeText}" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource LicenseStatus}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    <TextBlock Text="{Binding Shell.LicenseStateText}" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Expires}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    <TextBlock Text="{Binding Shell.LicenseExpiryText}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Shell.LicenseRemainingText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="3"
                        Content="{DynamicResource Logout}"
                        Style="{StaticResource GhostButton}"
                        VerticalAlignment="Center"
                        Command="{Binding Shell.LogoutCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource HoloCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="VALORANT" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Shell.StatusHeadline}"
                               FontSize="26"
                               FontWeight="Light"
                               Margin="0,10,0,8"
                               TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2"
                               Text="{Binding Shell.InstallMessage}"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                    <WrapPanel Grid.Row="3" Margin="0,20,0,0">
                        <Button Content="{DynamicResource Launch}"
                                Style="{StaticResource SolidButton}"
                                Margin="0,0,10,8"
                                Command="{Binding Shell.LaunchCommand}"
                                IsEnabled="{Binding Shell.CanLaunch}"/>
                        <Button Content="{DynamicResource Download}"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,10,8"
                                Command="{Binding Shell.DownloadCommand}"
                                Visibility="{Binding Shell.ShowDownload, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{DynamicResource RetryScan}"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,10,8"
                                Command="{Binding Shell.ScanCommand}"
                                Visibility="{Binding Shell.ShowRetryScan, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Border Padding="13,11"
                                Background="#12141A"
                                BorderBrush="#343741"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="{Binding Shell.Busy, Converter={StaticResource BoolToVis}}">
                            <Border.RenderTransform>
                                <TranslateTransform Y="6"/>
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Shell.Busy}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="6" To="0" Duration="0:0:0.24"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Style="{StaticResource PulseProgress}" IsIndeterminate="True" Width="40" Height="3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource LaunchingValorant}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="13,11"
                                Background="#12141A"
                                BorderBrush="#343741"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="{Binding Shell.IsValorantRunning, Converter={StaticResource BoolToVis}}">
                            <Border.RenderTransform>
                                <TranslateTransform Y="6"/>
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Shell.IsValorantRunning}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="6" To="0" Duration="0:0:0.24"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{DynamicResource ValorantRunningResult}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource HoloCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource InstallPath}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Shell.InstallPathText}"
                               ToolTip="{Binding Shell.InstallPathText}"
                               FontSize="14"
                               Margin="0,10,0,8"
                               TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2"
                               Text="{Binding Shell.Error}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Button Grid.Row="3"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"
                            Content="{DynamicResource Browse}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding Shell.BrowseCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

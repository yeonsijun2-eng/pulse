<UserControl x:Class="Pulse.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pulse.Controls"
             xmlns:models="clr-namespace:Pulse.Models">
    <Grid Margin="56,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Setup}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Calibrating}" FontSize="32" FontWeight="Light" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" TextWrapping="Wrap"/>
            <ProgressBar Style="{StaticResource PulseProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="1" MinHeight="4"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Margin="0,28,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SetupStep}">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Number}" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Light" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:CheckMark Grid.Column="2"
                                            VerticalAlignment="Top"
                                            IsComplete="{Binding IsComplete}"
                                            IsNotFound="{Binding IsNotFound}"
                                            Animate="True"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding DataContext.Error, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       VerticalAlignment="Center"/>
            <Button Content="{DynamicResource Retry}"
                    Style="{StaticResource SolidButton}"
                    Margin="18,0,0,0"
                    Command="{Binding DataContext.RetrySetupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</UserControl>
